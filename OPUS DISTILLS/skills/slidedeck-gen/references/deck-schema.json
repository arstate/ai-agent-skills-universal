{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SlideDeckGoalSpec",
  "description": "Schema definition for slidedeck-gen structured presentations",
  "type": "object",
  "required": ["schemaVersion", "title", "themePack", "slides"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [2]
    },
    "title": {
      "type": "string",
      "description": "Presentation title"
    },
    "goal": {
      "type": "string",
      "description": "Core executive goal and takeaway of the deck"
    },
    "audience": {
      "type": "string",
      "description": "Target audience persona"
    },
    "themePack": {
      "type": "string",
      "enum": [
        "theme01", "theme02", "theme03", "theme04",
        "theme05", "theme06", "theme07", "theme08",
        "theme09", "theme10", "theme11", "theme12"
      ]
    },
    "language": {
      "type": "string",
      "enum": ["en", "zh"],
      "default": "en"
    },
    "variantOutputMode": {
      "type": "string",
      "enum": ["selected-only", "comparison"],
      "default": "selected-only"
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "content", "selectedVariant", "variants"],
        "properties": {
          "id": {
            "type": "string"
          },
          "content": {
            "type": "object",
            "description": "Slide content map and presentation payload"
          },
          "selectedVariant": {
            "type": "string",
            "enum": ["v1", "v2", "v3", "v4"],
            "default": "v1"
          },
          "variants": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["id", "kind"],
              "properties": {
                "id": {
                  "type": "string",
                  "enum": ["v1", "v2", "v3", "v4"]
                },
                "kind": {
                  "type": "string",
                  "enum": ["template", "bespoke"]
                },
                "layout": {
                  "type": "string"
                },
                "contentMap": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
